<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- University -->
    <xs:element name="university">
        <xs:complexType>
            <xs:sequence>
                <!-- Department -->
                <xs:element name="department">
                    <xs:complexType>
                        <xs:sequence>
                            <!-- Student -->
                            <xs:element name="student">
                                <xs:complexType>
                                    <xs:sequence>
                                        <!-- Personal Details -->
                                        <xs:element name="personalDetails">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="name" type="xs:string"/>
                                                    <xs:element name="email" type="xs:string"/>
                                                    <xs:element name="contact" type="xs:string"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                        <!-- Courses -->
                                        <xs:element name="courses">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="course" maxOccurs="unbounded">
                                                        <xs:complexType>
                                                            <xs:sequence>
                                                                <xs:element name="title" type="xs:string"/>
                                                                <xs:element name="semester" type="xs:positiveInteger"/>
                                                                <xs:element name="grade" type="xs:string"/>
                                                            </xs:sequence>
                                                            <!-- Course Attributes -->
                                                            <xs:attribute name="code" type="xs:string" use="required"/>
                                                            <xs:attribute name="credits" type="xs:decimal" use="required"/>
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                    <!-- Student Attributes -->
                                    <xs:attribute name="rollno" type="xs:string" use="required"/>
                                    <xs:attribute name="status" type="xs:string" use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                        <!-- Department Attribute -->
                        <xs:attribute name="name" type="xs:string" use="required"/>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <!-- University Attribute -->
            <xs:attribute name="name" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>
</xs:schema>